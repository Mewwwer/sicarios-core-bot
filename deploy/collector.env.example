# GGE_CLIENT_VERSION=

# v0.2 snapshots and separate defense pilot, both off by default.
GAME_COMMANDS_ENABLED=false
DEFENSE_LOOKUP_ENABLED=false
GGE_MEMBERS_POLL_SECONDS=60
# SICARIOS on WORLD 2: GGE_SERVER_ID=world2 and GGE_ALLIANCE_ID=3540.
# Keep the already verified game endpoint/zone and secrets unchanged.
