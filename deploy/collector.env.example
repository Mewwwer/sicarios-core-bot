GGE_SERVER_ID=REPLACE_WITH_SAME_SERVER_CODE_AS_CORE
GGE_GAME_URL=wss://REPLACE_WITH_REAL_GAME_ENDPOINT/
GGE_GAME_ZONE=REPLACE_WITH_REAL_EMPIRE_ZONE
GGE_ALLIANCE_ID=REPLACE_WITH_SICARIOS_GAME_ALLIANCE_ID
GGE_USERNAME=REPLACE_USING_NORTHFLANK_SECRET
GGE_PASSWORD=REPLACE_USING_NORTHFLANK_SECRET
ATTACK_CORE_URL=http://REPLACE_WITH_CORE_PRIVATE_HOST:8080
ATTACK_SHARED_SECRET=REPLACE_WITH_SAME_RANDOM_SECRET_AS_CORE
GGE_POLL_SECONDS=30
ATTACK_HEARTBEAT_SECONDS=15
ATTACK_HTTP_TIMEOUT=8
COLLECTOR_HEALTH_PORT=8081
