# Add to existing Core Northflank environment variables. Do not commit real secrets.
ATTACK_MONITOR_ENABLED=true
# Starts with ping DISABLED. Use a separate test channel ID for the first pilot.
ATTACK_DRY_RUN=true
GGE_SERVER_ID=REPLACE_WITH_SERVER_CODE
ATTACK_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ATTACK_CHANNEL_ID=REPLACE_WITH_DISCORD_CHANNEL_ID
ATTACK_ROLE_ID=REPLACE_WITH_ATTACK_ALERTS_ROLE_ID
ATTACK_STATUS_CHANNEL_ID=REPLACE_WITH_BOT_STATUS_CHANNEL_ID
ATTACK_HTTP_PORT=8080
ATTACK_HTTP_HOST=0.0.0.0
ATTACK_STALE_SECONDS=120
ATTACK_STARTUP_GRACE_SECONDS=180
# Already present in Core:
DISCORD_GUILD_ID=REPLACE_WITH_EXISTING_GUILD_ID
# DISCORD_TOKEN belongs to Core only and is already configured there.

# v0.2 read commands: opt-in, independent defense pilot.
# Requires ATTACK_MONITOR_ENABLED=true and the existing shared secret/server ID.
GAME_COMMANDS_ENABLED=false
DEFENSE_LOOKUP_ENABLED=false
# Required on Core when GAME_COMMANDS_ENABLED=true; SICARIOS WORLD 2 uses 3540.
GGE_ALLIANCE_ID=3540
GAME_COMMAND_CHANNEL_ID=REPLACE_WITH_INTERNAL_COMMAND_CHANNEL_ID
# Only used when defense is enabled; private service origin, no public port.
ATTACK_COLLECTOR_URL=http://sicarios-attack-collector:8081
